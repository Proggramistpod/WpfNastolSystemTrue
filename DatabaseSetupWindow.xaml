<Window x:Class="WpfNastolSystem.Windows.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка подключения к базе данных"
        Height="634" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF6FF" Icon="images.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Настройка подключения к MySQL"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <Grid Height="62" Margin="0,0,0,16">
                <Border Style="{StaticResource InputBorderStyle}"/>
                <TextBlock x:Name="HintServer"
                           Text="Сервер *"
                           Style="{StaticResource FloatingHintTextBoxStyle}"
                           IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ServerTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBox x:Name="tbServer"
                         Padding="16,12,16,0"
                         FontSize="15"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Bottom"
                         CaretBrush="{StaticResource PrimaryBlue}"
                         Margin="0,0,0,10"/>
            </Grid>
            <Grid Height="62" Margin="0,0,0,16">
                <Border Style="{StaticResource InputBorderStyle}"/>
                <TextBlock x:Name="HintDatabase"
                           Text="База данных *"
                           Style="{StaticResource FloatingHintTextBoxStyle}"
                           IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="DatabaseTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBox x:Name="tbDatabase"
                         Padding="16,12,16,0"
                         FontSize="15"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Bottom"
                         CaretBrush="{StaticResource PrimaryBlue}"
                         Margin="0,0,0,10"/>
            </Grid>

            <!-- Поле: Логин -->
            <Grid Height="62" Margin="0,0,0,16">
                <Border Style="{StaticResource InputBorderStyle}"/>
                <TextBlock x:Name="HintUser"
                           Text="Логин *"
                           Style="{StaticResource FloatingHintTextBoxStyle}"
                           IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="UserTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBox x:Name="tbUser"
                         Padding="16,12,16,0"
                         FontSize="15"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Bottom"
                         CaretBrush="{StaticResource PrimaryBlue}"
                         Margin="0,0,0,10"/>
            </Grid>

            <!-- Поле: Пароль -->
            <Grid Height="62" Margin="0,0,0,16">
                <Border Style="{StaticResource InputBorderStyle}"/>
                <TextBlock x:Name="HintPassword"
                           Text="Пароль"
                           Style="{StaticResource FloatingHintTextBoxStyle}"
                           IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="PasswordTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <PasswordBox x:Name="pbPassword"
                             Padding="16,12,16,0"
                             FontSize="15"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Bottom"
                             CaretBrush="{StaticResource PrimaryBlue}"
                             Margin="0,0,0,10"/>
            </Grid>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="tbError" Foreground="Red" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Проверить подключение"
                    Style="{StaticResource MinimalWhiteBlueButton}"
                    Width="193"
                    Height="40"
                    Margin="0,0,12,0"
                    Click="TestConnection_Click"/>
            <Button Content="Сохранить"
                    Style="{StaticResource CustomBlueButtonStyle}"
                    Background="#28a745"
                    BorderBrush="#28a745"
                    Width="109"
                    Height="40"
                    Margin="0,0,12,0"
                    Click="Save_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource CustomBlueButtonStyle}"
                    Background="#6c757d"
                    BorderBrush="#6c757d"
                    Width="114"
                    Height="40"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>